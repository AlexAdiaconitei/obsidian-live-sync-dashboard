# Use the release's dokploy.env.example for exact published GHCR image digests.
# These image paths are placeholders, not published packages.
PANEL_IMAGE=ghcr.io/your-github-owner/your-repository:1.0.0
BACKUP_IMAGE=ghcr.io/your-github-owner/your-repository-backup:1.0.0
# Enable MagicDNS and HTTPS, and use the exact DNS name Tailscale assigned to this node.
TS_FQDN=notes.your-tailnet.ts.net
TS_HOSTNAME=notes
TS_AUTHKEY=replace-with-tailscale-auth-key-authorized-for-tag-notes
COUCHDB_USER=dashboard-admin
COUCHDB_PASSWORD=replace-with-long-random-password
PANEL_ADMINS=admin@example.com
PANEL_CSRF_SECRET=replace-with-at-least-32-random-characters
PANEL_DB=livesync_dashboard
INSTANCE_QUOTA_GIB=10
DEFAULT_USER_QUOTA_GIB=1
QUOTA_RECOVER_PENDING=0
TZ=UTC
AGE_RECIPIENT=age1replace-with-public-recipient
RCLONE_CONF_B64=replace-with-base64-config
# Any rclone remote. For S3, keep the trailing slash: s3:my-backups/obsidian/
RCLONE_REMOTE=gdrive:homelab-backups/obsidian
BACKUP_CRON=30 3 * * *
RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
PUSH_URL=
# Optional second backup destination with its own schedule and retention.
# Set COMPOSE_PROFILES=secondary-backup to start it. The panel shows only the primary worker.
COMPOSE_PROFILES=
SECONDARY_RCLONE_CONF_B64=
SECONDARY_RCLONE_REMOTE=
SECONDARY_BACKUP_CRON=30 5 * * 0
SECONDARY_RETENTION_DAYS=180
SECONDARY_PUSH_URL=
# Only for compose.dokploy.existing.yml. No backup variables are needed there.
COUCHDB_URL=https://private-couchdb.example.ts.net

# Optional personal Drive backups. Configure a Google web OAuth client once.
# See https://alexadiaconitei.github.io/obsidian-live-sync-dashboard/docs/backups/personal/. Each owner authorizes their own account.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Encrypts the stored Google tokens: 32 random bytes, base64. Keep the same key across upgrades.
GOOGLE_DRIVE_TOKEN_KEY=

# Optional Google Picker folder selection: a browser API key and the numeric Cloud project number.
# Enable the Picker API and restrict the key to the owner origin and https://docs.google.com/*.
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_PROJECT_NUMBER=
